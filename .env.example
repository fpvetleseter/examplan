# Copy locally to .env.local. Replace placeholders with public project config.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# No AI key is required for core save/list or template study plans.
# Optional: Gemini API key (free tier) for AI syllabus parsing on upload. Server-only, never NEXT_PUBLIC_.
# Leave empty to use only the built-in parser.
GEMINI_API_KEY=
